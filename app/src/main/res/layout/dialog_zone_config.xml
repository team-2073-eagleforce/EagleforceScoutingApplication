<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left Panel - Zone Config -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone Configuration"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone Name:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edit_zone_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Reef A, Source 1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone Type:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_zone_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone Color:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_color_red"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="R"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FFFF0000"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_color_blue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="B"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF0000FF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_color_green"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="G"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF00FF00"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_color_yellow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="Y"
                android:textColor="#000000"
                android:backgroundTint="#FFFFFF00" />

        </LinearLayout>

        <!-- Reef Layout (shown only for reef zones) -->
        <LinearLayout
            android:id="@+id/reef_layout_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reef Layout:"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <include
                android:id="@+id/reef_layout"
                layout="@layout/field_layout"
                android:layout_width="120dp"
                android:layout_height="90dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Right Panel - Action Bar Preview -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Action Bar Preview"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#F0F0F0"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/action_preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_add_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Action"
                android:textColor="#000000"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_remove_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Remove Action"
                android:textColor="#000000"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_lock_zone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lock Zone"
            android:textColor="#000000"
            android:backgroundTint="#FFFFCC00"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</LinearLayout>
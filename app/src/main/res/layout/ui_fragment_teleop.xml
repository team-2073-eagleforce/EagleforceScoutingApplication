<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_centerVertical="true"

            android:layout_gravity="center_vertical">
        <include
            android:id="@+id/teleop_net"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/add_subtract_values_net"
            android:layout_marginBottom="10dp" />
        <include
            android:id="@+id/teleop_removed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/add_subtract_values_removed"
            android:layout_marginBottom="10dp" />
        <include
            android:id="@+id/teleop_processor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/add_subtract_values_processor"/>
        </LinearLayout>

        <include
            android:id="@+id/teleop_reef"
            layout="@layout/reef_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"/>


    </RelativeLayout>


</ScrollView>
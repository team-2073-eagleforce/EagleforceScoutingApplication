<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">


    <Button
        android:id="@+id/largeMinus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f25c54"
        android:gravity ="center"
        android:text="-20"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/mediumMinus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f27059"
        android:layout_below= "@id/largeMinus"
        android:gravity ="center"
        android:text="-10"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/smallMinus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f4845f"
        android:layout_below= "@id/mediumMinus"
        android:gravity ="center"
        android:text="-5"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/oneMinus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f79d65"
        android:layout_below= "@id/smallMinus"
        android:gravity ="center"
        android:text="-1"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/largePlus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f25c54"
        android:layout_alignParentEnd= "true"
        android:gravity ="center"
        android:text="+20"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/mediumPlus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f27059"
        android:layout_below= "@id/largePlus"
        android:layout_alignParentEnd= "true"
        android:layout_marginLeft= "10dp"
        android:gravity ="center"
        android:text="+10"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/smallPlus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:layout_marginLeft= "10dp"
        android:backgroundTint="#f4845f"
        android:layout_below= "@id/mediumPlus"
        android:layout_alignParentEnd= "true"
        android:gravity ="center"
        android:text="+5"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/onePlus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:layout_marginLeft= "10dp"
        android:backgroundTint="#f79d65"
        android:layout_below="@id/smallPlus"
        android:layout_alignParentEnd= "true"
        android:gravity ="center"
        android:text="+1"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/passToggle"
        android:layout_width="350dp"
        android:layout_height="70dp"
        android:backgroundTint="#56d678"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="5dp"
        android:text="Score"
        android:textSize="35sp"/>
    <TextView
        android:id="@+id/scoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Score:"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#2E5F3B"/>
    <TextView
        android:id="@+id/scoreCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:inputType="number"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/scoreText"
        android:textAlignment="center"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#4C9D62"/>
    <TextView
        android:id="@+id/passText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        android:layout_below="@id/scoreText"
        android:gravity="center"
        android:text="Passes:"
        android:layout_centerHorizontal="true"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#483162"/>
    <TextView
        android:id="@+id/passCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:inputType="number"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/passText"
        android:textAlignment="center"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#734D9F"/>


</RelativeLayout>

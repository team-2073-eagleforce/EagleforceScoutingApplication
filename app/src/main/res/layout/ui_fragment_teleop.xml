<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">


    <Button
        android:id="@+id/largeMinus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f68c4e"
        android:gravity ="center"
        android:text="-20"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/mediumMinus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f68c4e"
        android:layout_below= "@id/largeMinus"
        android:text="-10"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/smallMinus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f68c4e"
        android:layout_below= "@id/mediumMinus"
        android:text="-5"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/oneMinus"
        android:layout_width="200dp"
        android:layout_height="85dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f68c4e"
        android:layout_below= "@id/smallMinus"
        android:text="-1"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/largePlus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f68c4e"
        android:layout_alignParentEnd= "true"
        android:text="+20"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/mediumPlus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f68c4e"
        android:layout_below= "@id/largePlus"
        android:layout_alignParentEnd= "true"
        android:layout_marginLeft= "10dp"
        android:text="+10"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/smallPlus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:layout_marginLeft= "10dp"
        android:backgroundTint="#f68c4e"
        android:layout_below= "@id/mediumPlus"
        android:layout_alignParentEnd= "true"
        android:text="+5"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/onePlus"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:layout_marginLeft= "10dp"
        android:backgroundTint="#f68c4e"
        android:layout_below= "@id/smallPlus"
        android:layout_alignParentEnd= "true"
        android:text="+1"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/scoreToggle"
        android:layout_width="200dp"
        android:layout_height="75dp"
        android:backgroundTint="#59d97b"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/largeMinus"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="5dp"
        android:text="Score"
        android:textSize="35sp"/>
    <Button
        android:id="@+id/passToggle"
        android:layout_width="200dp"
        android:layout_height="75dp"
        android:backgroundTint="#7187ab"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@id/largePlus"
        android:layout_marginRight="45dp"
        android:layout_marginTop="5dp"
        android:text="Pass"
        android:textSize="35sp"/>
    <TextView
        android:id="@+id/scoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:text="Score:"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"
        android:textSize="40sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/scoreCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:inputType="number"
        android:text="0"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/scoreText"
        android:textAlignment="center"
        android:textSize="40sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/passText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        android:layout_below="@id/scoreText"
        android:gravity="center"
        android:text="Passes:"
        android:layout_centerHorizontal="true"
        android:textSize="40sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/passCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:inputType="number"
        android:text="0"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/passText"
        android:textAlignment="center"
        android:textSize="40sp"
        android:textStyle="bold" />


</RelativeLayout>

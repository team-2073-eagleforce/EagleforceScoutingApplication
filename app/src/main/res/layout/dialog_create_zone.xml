<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zone Name:"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/edit_zone_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. Reef A, Source 1, Barge"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available Actions:"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/edit_zone_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="pickup_coral,score_coral,pickup_algae"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Separate actions with commas"
        android:textSize="12sp"
        android:textColor="#666666" />

</LinearLayout>
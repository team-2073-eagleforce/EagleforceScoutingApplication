<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <RelativeLayout
        android:layout_width="1100dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center">


        <SeekBar
            android:id="@+id/accuracySeekBar"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_alignParentLeft="true"
            android:indeterminate="false"
            android:max="100"
            android:progress="50"
            android:rotation="270"
            android:valueFrom="0.0"
            android:valueTo="100.0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accuracy:"
            android:textSize="24sp"
            android:layout_marginStart="185dp"
            android:layout_marginTop="75dp"
            android:gravity="center"
            android:textColor="#C00000"
            />

        <TextView
            android:id="@+id/accuracyValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50"
            android:textSize="40sp"
            android:layout_marginStart="200dp"
            android:layout_marginTop="120dp"
            android:gravity="center"
            android:textColor="#050505"
            />

        <include
            android:id="@+id/driverPerformance"
            layout="@layout/add_subtract_values"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true" />

        <include
            android:id="@+id/defensePerformance"
            layout="@layout/add_subtract_values"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/driverPerformance"
            android:layout_centerHorizontal="true" />

        <EditText
            android:id="@+id/uiComments"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/defensePerformance"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp"
            android:ellipsize="start"
            android:ems="10"
            android:gravity="center"
            android:inputType="textMultiLine"
            android:maxLength="115"
            android:hint="Comments"
            android:textColorHint="@color/md_blue_grey_200"/>

        <LinearLayout
            android:id="@+id/robotConditions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@+id/uiComments"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp">

            <CheckBox
                android:id="@+id/checkBroken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Broken"
                android:layout_marginEnd="10dp"
            />

            <CheckBox
                android:id="@+id/checkDisabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disabled"
                android:layout_marginEnd="10dp"
                />

            <CheckBox
                android:id="@+id/checkTipped"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipped"
                />
        </LinearLayout>


    </RelativeLayout>

</ScrollView>
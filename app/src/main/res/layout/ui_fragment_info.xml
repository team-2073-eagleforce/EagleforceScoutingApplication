<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|clip_vertical">
        <LinearLayout
            android:id="@+id/textFields"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textName"
                android:layout_width="200dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="@string/scout_name"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"/>

            <EditText
                android:id="@+id/editTextName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:gravity="center"
                android:inputType="textPersonName"/>

            <TextView
                android:id="@+id/textMatchNumber"
                android:layout_width="200dp"
                android:layout_height="30dp"
                android:layout_marginTop="30dp"
                android:ems="10"
                android:gravity="center"
                android:text="@string/match_number"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:layout_gravity="center_horizontal"/>

            <EditText
                android:id="@+id/editTextMatchNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:gravity="center"
                android:inputType="number" />

            <Spinner
                android:id="@+id/selectMatchType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"/>


            <TextView
                android:id="@+id/textTeamNumber"
                android:layout_width="200dp"
                android:layout_height="30dp"
                android:layout_marginTop="30dp"
                android:ems="10"
                android:gravity="center"
                android:text="@string/team_number"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:layout_gravity="center_horizontal"/>

            <EditText
                android:id="@+id/editTextTeamNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:gravity="center"
                android:inputType="number" />
        </LinearLayout>

        <ImageView
            android:layout_centerVertical="true"
            android:id="@+id/start_map"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_toEndOf="@id/textFields"
            android:layout_marginStart="20dp"
            android:background="@drawable/red_proc_processor"/>

        <RadioGroup
            android:id="@+id/start_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:layout_toEndOf="@id/start_map">

            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="Start Position"
                android:gravity="center"
                android:textColor="@color/md_black_1000"
                android:textStyle="bold"
                android:textSize="20sp"/>

            <RadioButton
                android:id="@+id/pos0"
                android:layout_width="125dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:padding="4dp"
                android:text="No Show"
                android:textSize="20sp" />

            <RadioButton
                android:id="@+id/pos1"
                android:layout_width="125dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:padding="4dp"
                android:text="1"
                android:textSize="20sp" />

            <RadioButton
                android:id="@+id/pos2"
                android:layout_width="125dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:padding="4dp"
                android:text="2"
                android:textSize="20sp" />

            <RadioButton
                android:id="@+id/pos3"
                android:layout_width="125dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:padding="4dp"
                android:text="3"
                android:textSize="20sp" />

            <RadioButton
                android:id="@+id/pos4"
                android:layout_width="125dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:padding="4dp"
                android:text="4"
                android:textSize="20sp" />

            <RadioButton
                android:id="@+id/pos5"
                android:layout_width="125dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:padding="4dp"
                android:text="5"
                android:textSize="20sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_toEndOf="@id/start_position"
            android:layout_alignBottom="@+id/start_position"
            android:text="let's go 2073"/>

        <Button
            android:id="@+id/start_recording_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/msg"
            android:layout_toEndOf="@id/start_position"
            android:layout_marginTop="12dp"
            android:text="@string/start_recording"
            android:backgroundTint="@color/md_red_700"
            android:textColor="@android:color/white"
            android:visibility="gone" />

    </RelativeLayout>
</ScrollView>

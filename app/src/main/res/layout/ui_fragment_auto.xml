<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <RadioGroup
            android:id="@+id/auto_reef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:layout_alignParentEnd="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level"
                android:gravity="center"
                android:textColor="@color/md_black_1000"
                android:textStyle="bold"
                android:textSize="20sp"/>

            <RadioButton
                android:id="@+id/L4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="4"
                android:textSize="50sp" />

            <RadioButton
                android:id="@+id/L3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="3"
                android:textSize="50sp" />

            <RadioButton
                android:id="@+id/L2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="2"
                android:textSize="50sp" />

            <RadioButton
                android:id="@+id/L1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="1"
                android:textSize="50sp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/auto_algae"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true">
            <include
                android:id="@+id/auto_net"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/add_subtract_values_net"
                android:layout_marginBottom="10dp">
            </include>
            <include
                android:id="@+id/auto_removed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/add_subtract_values_removed"
                android:layout_marginBottom="10dp">
            </include>
            <Button
                android:id="@+id/auto_leave"
                android:layout_height="50dp"
                android:layout_width="match_parent"
                android:text="NONE"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:backgroundTint="@color/unselected">
            </Button>
        </LinearLayout>

        <include
            android:id="@+id/auto_field"
            layout="@layout/field_layout"
            android:layout_toRightOf="@id/auto_algae"
            android:layout_marginLeft="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true" />
    </RelativeLayout>

</ScrollView>
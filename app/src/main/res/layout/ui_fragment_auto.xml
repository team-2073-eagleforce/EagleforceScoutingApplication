<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <RadioGroup
            android:id="@+id/auto_reef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:layout_alignParentEnd="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level"
                android:gravity="center"
                android:textColor="@color/md_black_1000"
                android:textStyle="bold"
                android:textSize="20sp"/>

            <RadioButton
                android:id="@+id/L4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="4"
                android:textSize="50sp" />

            <RadioButton
                android:id="@+id/L3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="3"
                android:textSize="50sp" />

            <RadioButton
                android:id="@+id/L2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="2"
                android:textSize="50sp" />

            <RadioButton
                android:id="@+id/L1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="1"
                android:textSize="50sp" />
        </RadioGroup>

        <Button
            android:id="@+id/auto_leave"
            android:layout_height="50dp"
            android:layout_width="120dp"
            android:text="NONE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="@color/unselected"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp">
        </Button>

        <TextView
            android:id="@+id/path_info"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_below="@id/auto_leave"
            android:layout_marginTop="10dp"
            android:text="Draw path on field"/>

        <RelativeLayout
            android:id="@+id/field_container"
            android:layout_width="500dp"
            android:layout_height="350dp"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@id/auto_leave">

            <ImageView
                android:id="@+id/field_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/field_red_side"
                android:scaleType="centerInside"
                android:adjustViewBounds="true" />

            <com.team2073.eagleforcescoutingapplication.util.PathDrawingView
                android:id="@+id/drawing_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignTop="@id/field_background"
                android:layout_alignBottom="@id/field_background" />

            <include
                android:id="@+id/auto_field"
                layout="@layout/field_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible" />

        </RelativeLayout>

        <!-- Action Bar for waypoint actions -->
        <LinearLayout
            android:id="@+id/action_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E0E0E0"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_below="@id/field_container"
            android:layout_marginTop="10dp">
            
            <Button
                android:id="@+id/action_pickup_coral"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Pickup Coral"
                android:textSize="12sp"
                android:layout_marginEnd="5dp" />
            
            <Button
                android:id="@+id/action_pickup_algae"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Pickup Algae"
                android:textSize="12sp"
                android:layout_marginEnd="5dp" />
            
            <Button
                android:id="@+id/action_score_coral"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Score Coral"
                android:textSize="12sp"
                android:layout_marginEnd="5dp" />
            
            <Button
                android:id="@+id/action_score_algae"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Score Algae"
                android:textSize="12sp"
                android:layout_marginEnd="5dp" />
            
            <Button
                android:id="@+id/action_remove"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Remove"
                android:textSize="12sp"
                android:layout_marginEnd="5dp" />
            
            <Button
                android:id="@+id/action_cancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cancel"
                android:textSize="12sp"
                android:backgroundTint="#FF5722" />
            
        </LinearLayout>

    </RelativeLayout>

</ScrollView>
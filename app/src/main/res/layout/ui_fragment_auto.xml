<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">


    <Button
        android:id="@+id/largeMinusAuto"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f68c70"
        android:gravity ="center"
        android:text="-20"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/mediumMinusAuto"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f69c6d"
        android:layout_below= "@id/largeMinusAuto"
        android:gravity ="center"
        android:text="-10"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/smallMinusAuto"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f6ac69"
        android:layout_below= "@id/mediumMinusAuto"
        android:gravity ="center"
        android:text="-5"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/oneMinusAuto"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f6bc66"
        android:layout_below= "@id/smallMinusAuto"
        android:gravity ="center"
        android:text="-1"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/largePlusAuto"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f68c70"
        android:layout_alignParentEnd= "true"
        android:gravity ="center"
        android:text="+20"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/mediumPlusAuto"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:backgroundTint="#f69c6d"
        android:layout_below= "@id/largePlusAuto"
        android:layout_alignParentEnd= "true"
        android:layout_marginLeft= "10dp"
        android:gravity ="center"
        android:text="+10"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/smallPlusAuto"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:layout_marginLeft= "10dp"
        android:backgroundTint="#f6ac69"
        android:layout_below= "@id/mediumPlusAuto"
        android:layout_alignParentEnd= "true"
        android:gravity ="center"
        android:text="+5"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/onePlusAuto"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop= "3dp"
        android:layout_marginLeft= "10dp"
        android:backgroundTint="#f6bc66"
        android:layout_below= "@id/smallPlusAuto"
        android:layout_alignParentEnd= "true"
        android:gravity ="center"
        android:text="+1"
        android:textSize="50sp"/>
    <Button
        android:id="@+id/passToggleAuto"
        android:layout_width="350dp"
        android:layout_height="70dp"
        android:backgroundTint="#56d678"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="5dp"
        android:text="Score"
        android:textSize="35sp"
        />
    <Button
        android:id="@+id/autoClimbMiddle"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:backgroundTint="#8e9aaf"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp"
        android:text="Middle Climb?"
        android:textSize="18sp"/>
    <Button
        android:id="@+id/autoClimbLeft"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:backgroundTint="#8e9aaf"
        android:layout_alignParentTop="true"
        android:layout_marginTop="5dp"
        android:layout_toLeftOf="@id/autoClimbMiddle"
        android:layout_marginRight="5dp"
        android:text="Left Climb?"
        android:textSize="18sp"/>
    <Button
        android:id="@+id/autoClimbRight"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:backgroundTint="#8e9aaf"
        android:layout_alignParentTop="true"
        android:layout_marginTop="5dp"
        android:layout_toRightOf="@id/autoClimbMiddle"
        android:layout_marginLeft="5dp"
        android:text="Right Climb?"
        android:textSize="18sp"/>
    <Button
        android:id="@+id/autoLeave"
        android:layout_width="125dp"
        android:layout_height="70dp"
        android:backgroundTint="#707a8c"
        android:layout_centerVertical="true"
        android:layout_marginTop="5dp"
        android:layout_below="@id/autoClimbRight"
        android:layout_alignRight="@id/autoClimbRight"
        android:layout_marginLeft="5dp"
        android:text="Auto Leave?"
        android:textSize="18sp"/>
    <TextView
        android:id="@+id/scoreTextAuto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        android:gravity="center"
        android:text="Score:"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"
        android:textSize="35sp"
        android:textStyle="bold"
        android:textColor="#2E5F3B"/>
    <TextView
        android:id="@+id/scoreCounterAuto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:inputType="number"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/scoreTextAuto"
        android:textAlignment="center"
        android:textSize="35sp"
        android:textStyle="bold"
        android:textColor="#4C9D62"/>
    <TextView
        android:id="@+id/passTextAuto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:layout_below="@id/scoreTextAuto"
        android:gravity="center"
        android:text="Passes:"
        android:layout_centerHorizontal="true"
        android:textSize="35sp"
        android:textStyle="bold"
        android:textColor="#483162"/>
    <TextView
        android:id="@+id/passCounterAuto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:inputType="number"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/passTextAuto"
        android:textAlignment="center"
        android:textSize="35sp"
        android:textStyle="bold"
        android:textColor="#734D9F"/>


</RelativeLayout>
